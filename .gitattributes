# Normalize line endings: LF in the repository and in working trees on every OS
* text=auto eol=lf

# Binary files: no line ending conversion, no textual diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.fig binary
*.sketch binary
*.psd binary
*.ai binary
*.afdesign binary
